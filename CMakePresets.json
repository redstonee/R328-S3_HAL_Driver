{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "sram-debug",
      "displayName": "R328-S3 loader/debugger to SRAM, Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "R328_MEMORY": "SRAM",
        "R328_UART0_ROUTE": "PH0_PH1",
        "R328_FEL_IMAGE": "OFF",
        "R328_GIC_SECURITY": "SECURE"
      }
    },
    {
      "name": "fel-debug",
      "inherits": "sram-debug",
      "displayName": "R328-S3 FEL to SRAM (128 KiB), Debug",
      "cacheVariables": {
        "R328_FEL_IMAGE": "ON",
        "R328_GIC_SECURITY": "SECURE",
        "R328_FEL_SRAM_PROFILE": "FULL"
      }
    },
    {
      "name": "fel-release",
      "inherits": "fel-debug",
      "displayName": "R328-S3 FEL to SRAM (128 KiB), Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ddr-debug",
      "inherits": "sram-debug",
      "displayName": "R328-S3 loader to initialized DDR, Debug",
      "cacheVariables": {
        "R328_MEMORY": "DDR"
      }
    },
    {
      "name": "sram-release",
      "inherits": "sram-debug",
      "displayName": "R328-S3 loader/debugger to SRAM, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "fel-direct",
      "inherits": "fel-debug",
      "displayName": "R328-S3 FEL to SRAM (32 KiB fallback)",
      "cacheVariables": {
        "R328_FEL_SRAM_PROFILE": "DIRECT"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sram-debug",
      "configurePreset": "sram-debug"
    },
    {
      "name": "fel-debug",
      "configurePreset": "fel-debug"
    },
    {
      "name": "fel-release",
      "configurePreset": "fel-release"
    },
    {
      "name": "ddr-debug",
      "configurePreset": "ddr-debug"
    },
    {
      "name": "sram-release",
      "configurePreset": "sram-release"
    },
    {
      "name": "fel-direct",
      "configurePreset": "fel-direct"
    }
  ],
  "testPresets": [
    {
      "name": "sram-debug",
      "configurePreset": "sram-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-debug",
      "configurePreset": "fel-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-release",
      "configurePreset": "fel-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ddr-debug",
      "configurePreset": "ddr-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sram-release",
      "configurePreset": "sram-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-direct",
      "configurePreset": "fel-direct",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
