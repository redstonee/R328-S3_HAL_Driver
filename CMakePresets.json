{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "sram-debug",
      "hidden": true,
      "displayName": "R328-S3 loader/debugger to SRAM, Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "R328_MEMORY": "SRAM",
        "R328_FEL_IMAGE": "OFF",
        "R328_GIC_SECURITY": "SECURE",
        "R328_NAND_IMAGE": "OFF",
        "R328_NOR_IMAGE": "OFF",
        "R328_FEL_DDR_IMAGE": "OFF"
      }
    },
    {
      "name": "fel-debug",
      "inherits": "sram-debug",
      "displayName": "R328-S3 FEL to SRAM (128 KiB), Debug",
      "cacheVariables": {
        "R328_FEL_IMAGE": "ON",
        "R328_GIC_SECURITY": "SECURE",
        "R328_FEL_SRAM_PROFILE": "FULL"
      }
    },
    {
      "name": "fel-release",
      "inherits": "fel-debug",
      "displayName": "R328-S3 FEL to SRAM (128 KiB), Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ddr-debug",
      "hidden": true,
      "inherits": "sram-debug",
      "displayName": "R328-S3 loader to initialized DDR, Debug",
      "cacheVariables": {
        "R328_MEMORY": "DDR",
        "R328_DDR_ORIGIN": "0x40000000",
        "R328_DDR_LENGTH": "0x08000000"
      }
    },
    {
      "name": "fel-ddr-debug",
      "inherits": "ddr-debug",
      "displayName": "R328-S3 FEL to DDR (128 MiB), Debug",
      "cacheVariables": {
        "R328_FEL_DDR_IMAGE": "ON"
      }
    },
    {
      "name": "fel-ddr-release",
      "inherits": "fel-ddr-debug",
      "displayName": "R328-S3 FEL to DDR (128 MiB), Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "sram-release",
      "hidden": true,
      "inherits": "sram-debug",
      "displayName": "R328-S3 loader/debugger to SRAM, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "fel-direct",
      "inherits": "fel-debug",
      "displayName": "R328-S3 FEL to SRAM (32 KiB fallback)",
      "cacheVariables": {
        "R328_FEL_SRAM_PROFILE": "DIRECT"
      }
    },
    {
      "name": "nand-debug",
      "inherits": "ddr-debug",
      "displayName": "R328-S3 SPI NAND to DDR, Debug",
      "cacheVariables": {
        "R328_NAND_IMAGE": "ON",
        "R328_GIC_SECURITY": "SECURE",
        "R328_DDR_ORIGIN": "0x40000000",
        "R328_DDR_LENGTH": "0x08000000"
      }
    },
    {
      "name": "nand-release",
      "inherits": "nand-debug",
      "displayName": "R328-S3 SPI NAND to DDR, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "nor-debug",
      "inherits": "ddr-debug",
      "displayName": "R328-S3 W25Q64 SPI NOR to DDR, Debug",
      "cacheVariables": {
        "R328_NOR_IMAGE": "ON"
      }
    },
    {
      "name": "nor-release",
      "inherits": "nor-debug",
      "displayName": "R328-S3 W25Q64 SPI NOR to DDR, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "sram-debug",
      "hidden": true,
      "configurePreset": "sram-debug"
    },
    {
      "name": "fel-debug",
      "configurePreset": "fel-debug"
    },
    {
      "name": "fel-release",
      "configurePreset": "fel-release"
    },
    {
      "name": "fel-ddr-debug",
      "configurePreset": "fel-ddr-debug"
    },
    {
      "name": "fel-ddr-release",
      "configurePreset": "fel-ddr-release"
    },
    {
      "name": "ddr-debug",
      "hidden": true,
      "configurePreset": "ddr-debug"
    },
    {
      "name": "sram-release",
      "hidden": true,
      "configurePreset": "sram-release"
    },
    {
      "name": "fel-direct",
      "configurePreset": "fel-direct"
    },
    {
      "name": "nand-debug",
      "configurePreset": "nand-debug"
    },
    {
      "name": "nand-release",
      "configurePreset": "nand-release"
    },
    {
      "name": "nor-debug",
      "configurePreset": "nor-debug"
    },
    {
      "name": "nor-release",
      "configurePreset": "nor-release"
    }
  ],
  "testPresets": [
    {
      "name": "sram-debug",
      "hidden": true,
      "configurePreset": "sram-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-debug",
      "configurePreset": "fel-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-release",
      "configurePreset": "fel-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-ddr-debug",
      "configurePreset": "fel-ddr-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-ddr-release",
      "configurePreset": "fel-ddr-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ddr-debug",
      "hidden": true,
      "configurePreset": "ddr-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sram-release",
      "hidden": true,
      "configurePreset": "sram-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fel-direct",
      "configurePreset": "fel-direct",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nand-debug",
      "configurePreset": "nand-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nand-release",
      "configurePreset": "nand-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nor-debug",
      "configurePreset": "nor-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nor-release",
      "configurePreset": "nor-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
