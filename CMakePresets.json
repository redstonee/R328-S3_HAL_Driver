{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "sram-debug",
      "displayName": "R328-S3 SRAM Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "R328_MEMORY": "SRAM",
        "R328_UART0_ROUTE": "PH0_PH1",
        "R328_EXAMPLE": "",
        "R328_FEL_IMAGE": "OFF",
        "R328_GIC_SECURITY": "SECURE"
      }
    },
    {
      "name": "fel-debug",
      "inherits": "sram-debug",
      "displayName": "R328-S3 BROM FEL SRAM / UART0 PH0-PH1",
      "cacheVariables": {
        "R328_FEL_IMAGE": "ON",
        "R328_GIC_SECURITY": "SECURE",
        "R328_FEL_SRAM_PROFILE": "FULL"
      }
    },
    {
      "name": "fel-release",
      "inherits": "fel-debug",
      "displayName": "R328-S3 BROM FEL SRAM Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "ddr-debug",
      "inherits": "sram-debug",
      "displayName": "R328-S3 initialized DDR Debug",
      "cacheVariables": {
        "R328_MEMORY": "DDR"
      }
    },
    {
      "name": "sram-release",
      "inherits": "sram-debug",
      "displayName": "R328-S3 SRAM Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "fel-gpio-output",
      "inherits": "fel-debug",
      "displayName": "R328-S3 FEL gpio/output",
      "cacheVariables": {
        "R328_EXAMPLE": "gpio/output"
      }
    },
    {
      "name": "fel-gpio-input",
      "inherits": "fel-debug",
