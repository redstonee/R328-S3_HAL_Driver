set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(ARM_TOOLCHAIN_PREFIX
    arm-none-eabi
    CACHE STRING "GNU Arm toolchain prefix or full path prefix"
)
find_program(CMAKE_C_COMPILER NAMES ${ARM_TOOLCHAIN_PREFIX}-gcc REQUIRED)
find_program(CMAKE_ASM_COMPILER NAMES ${ARM_TOOLCHAIN_PREFIX}-gcc REQUIRED)
find_program(CMAKE_OBJCOPY NAMES ${ARM_TOOLCHAIN_PREFIX}-objcopy REQUIRED)
find_program(CMAKE_SIZE NAMES ${ARM_TOOLCHAIN_PREFIX}-size REQUIRED)
find_program(CMAKE_OBJDUMP NAMES ${ARM_TOOLCHAIN_PREFIX}-objdump REQUIRED)
find_program(CMAKE_NM NAMES ${ARM_TOOLCHAIN_PREFIX}-nm REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
